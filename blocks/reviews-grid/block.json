{
  "apiVersion": 3,
  "title": "Сетка отзывов",
  "name": "my-theme/reviews-grid",
  "category": "tolstenko-reviews",
  "icon": "grid-view",
  "description": "Все отзывы карточками с табами по типам и кнопкой «Показать ещё» — для страницы с шаблоном «Reviews page»",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "multiple": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "postIds": {
      "type": "array",
      "default": []
    },
    "per_page": {
      "type": "number"
    },
    "more_text": {
      "type": "string",
      "default": ""
    }
  },
  "render": "file:./template.php"
}
